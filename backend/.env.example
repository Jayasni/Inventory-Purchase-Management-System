# PostgreSQL connection
DB_USER=postgres
DB_PASSWORD=12345
DB_HOST=localhost
DB_PORT=5432
DB_NAME=inventory_purchase_db

# Generate a unique random secret for production
SECRET_KEY=replace_with_a_long_random_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional seed admin account (used by seed.py)
SEED_ADMIN_NAME=Inventory Admin
SEED_ADMIN_EMAIL=admin@gmail.com
SEED_ADMIN_PASSWORD=Admin@12345
